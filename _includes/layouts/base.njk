{% set hasSignup = page.url == '/' or page.url == '/newsletter/' %}
{% set hasLightbox = page.url == '/' or page.url == '/photos/' %}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <title>{{ seo.title | escape }}</title>
  <meta name="description" content="{{ seo.description | escape }}">
  <link rel="canonical" href="{{ seo.canonical | escape }}">
  {% if seo.noindex %}<meta name="robots" content="noindex, follow">{% endif %}
  <meta property="og:type" content="{{ seo.type }}">
  <meta property="og:site_name" content="{{ site.name | escape }}">
  <meta property="og:url" content="{{ seo.canonical | escape }}">
  <meta property="og:title" content="{{ seo.title | escape }}">
  <meta property="og:description" content="{{ seo.description | escape }}">
  <meta property="og:image" content="{{ seo.image.url | escape }}">
  <meta property="og:image:type" content="{{ seo.image.type }}">
  <meta property="og:image:width" content="{{ seo.image.width }}">
  <meta property="og:image:height" content="{{ seo.image.height }}">
  <meta property="og:image:alt" content="{{ seo.image.alt | escape }}">
  {% if seo.publishedTime %}<meta property="article:published_time" content="{{ seo.publishedTime }}">{% endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ seo.title | escape }}">
  <meta name="twitter:description" content="{{ seo.description | escape }}">
  <meta name="twitter:image" content="{{ seo.image.url | escape }}">
  <meta name="twitter:image:alt" content="{{ seo.image.alt | escape }}">
  <link rel="alternate" type="application/rss+xml" title="{{ site.name | escape }} — notes &amp; letters" href="{{ site.url }}/feed.xml">
  <link rel="alternate" type="application/rss+xml" title="{{ site.name | escape }} — notes" href="{{ site.url }}/notes/feed.xml">
  <link rel="alternate" type="application/rss+xml" title="{{ site.name | escape }} — letters" href="{{ site.url }}/newsletter/feed.xml">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="preload" href="{{ fonts.preload | escape }}" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/base.css?v={{ '/css/base.css' | assetVersion }}">
  {% if hasSignup %}<link rel="stylesheet" href="/css/subscribe.css?v={{ '/css/subscribe.css' | assetVersion }}">{% endif %}
  {% if template == 'gallery' %}<link rel="stylesheet" href="/css/gallery.css?v={{ '/css/gallery.css' | assetVersion }}">{% endif %}
  {% if hasLightbox %}<link rel="stylesheet" href="/css/lightbox.css?v={{ '/css/lightbox.css' | assetVersion }}">{% endif %}
  <script src="/js/site.js?v={{ '/js/site.js' | assetVersion }}" defer></script>
  {% if hasLightbox %}<script src="/js/lightbox.js?v={{ '/js/lightbox.js' | assetVersion }}" defer></script>{% endif %}
</head>
<body>
  <a class="skip-link" href="#page-title">skip to content</a>
  <div class="site-canvas{% if template == 'gallery' %} site-canvas--gallery{% endif %}"><div id="santi-linus-home">{{ content | safe }}</div></div>
  {% if hasLightbox %}{% include "partials/lightbox.njk" %}{% endif %}
</body>
</html>
