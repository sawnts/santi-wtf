{% set signupId = subscribeId or 'newsletter-subscribe' %}
<section class="newsletter-signup" aria-labelledby="{{ signupId }}-intro">
  <p class="newsletter-signup__intro" id="{{ signupId }}-intro">meet me in your inbox</p>
  <form class="newsletter-signup__form" action="https://buttondown.com/api/emails/embed-subscribe/sawnts" method="post" accept-charset="UTF-8">
    <label class="newsletter-signup__label" for="{{ signupId }}-email">your email</label>
    <div class="newsletter-signup__row">
      <input class="newsletter-signup__email" id="{{ signupId }}-email" type="email" name="email" placeholder="your email" autocomplete="email" autocapitalize="none" spellcheck="false" required>
      <input type="hidden" name="embed" value="1">
      <button class="newsletter-signup__button" type="submit">i’m in!</button>
    </div>
  </form>
</section>
