---
layout: layouts/base.njk
permalink: /newsletter/
title: letters
description: letters from santi villanueva on creativity, culture, politics, and paying attention. read the archive or subscribe.
---
<main class="page" id="main-content">
  {% include "nav.njk" %}
  <header class="page-header"><h1 id="page-title" tabindex="-1">{{ title }}</h1></header>
  <ul class="archive">
    {% for post in collections.newsletter %}<li><a href="{{ post.url }}"><span>{{ post.data.title }}</span><time datetime="{{ post.date | htmlDateString }}">{{ post.date | personalDate }}</time></a></li>{% endfor %}
  </ul>
  {% set subscribeId = 'letters-subscribe' %}
  {% include "partials/subscribe.njk" %}
</main>
