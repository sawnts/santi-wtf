---
layout: layouts/base.njk
permalink: /newsletter/
title: letters
---
<main class="page" id="main-content">
  {% include "nav.njk" %}
  <header class="page-header"><h1>{{ title }}</h1></header>
  <ul class="archive">
    {% for post in collections.newsletter %}<li><a href="{{ post.url }}"><span>{{ post.data.title }}</span><time datetime="{{ post.date | htmlDateString }}">{{ post.date | personalDate }}</time></a></li>{% endfor %}
  </ul>
  <p class="subscribe"><a href="https://buttondown.com/sawnts" target="_blank" rel="noopener noreferrer">meet me in your inbox — subscribe</a></p>
</main>
