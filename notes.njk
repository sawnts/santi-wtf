---
layout: layouts/base.njk
permalink: /notes/
title: notes
---
<main class="page" id="main-content">
  {% include "nav.njk" %}
  <header class="page-header"><h1 id="page-title" tabindex="-1">{{ title }}</h1></header>
  <ul class="archive">
    {% for post in collections.notes %}<li><a href="{{ post.url }}"><span>{{ post.data.title }}</span><time datetime="{{ post.date | htmlDateString }}">{{ post.date | personalDate }}</time></a></li>{% endfor %}
  </ul>
</main>
