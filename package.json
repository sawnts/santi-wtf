{
  "name": "santi-wtf",
  "version": "1.0.0",
  "type": "module",
  "description": "santi's digital garden",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prebuild": "node scripts/clean-site.mjs",
    "build": "eleventy",
    "build:construction": "node scripts/build-construction.mjs",
    "serve": "eleventy --serve",
    "start": "eleventy --serve",
    "check:site": "node scripts/check-site.mjs && node scripts/check-discovery.mjs",
    "check:construction": "node scripts/check-site.mjs --mode=construction",
    "test:browser": "playwright test",
    "test:unit": "node --test tests/*.test.js",
    "check": "npm run test:unit && npm run build:construction && npm run check:construction && npm run build && npm run check:site && npm run test:browser"
  },
  "author": {
    "name": "santi",
    "url": "https://santi.wtf/"
  },
  "license": "ISC",
  "dependencies": {
    "@11ty/eleventy": "^3.1.8",
    "@11ty/eleventy-img": "^7.1.1",
    "@11ty/eleventy-plugin-rss": "^3.1.0",
    "luxon": "^3.7.2",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "parse5": "^8.1.1",
    "saxes": "^6.0.0"
  }
}
